// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model JobStatus {
  id       Int      @id @default(autoincrement())
  name     String
  order    Int
  createAt DateTime @default(now())

  jobs Job[]

  @@map("job_statuses")
}

model Skill {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  createAt DateTime @default(now())

  mandatoryForJobs   Job[] @relation("MandatorySkills")
  recommendedForJobs Job[] @relation("RecommendedSkills")

  @@map("skills")
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  workModel   String
  salary      Float?
  description String
  appliedAt   DateTime
  createdAt   DateTime @default(now())

  statusId Int
  status   JobStatus @relation(fields: [statusId], references: [id])

  comments JobComment[]
  contacts JobContact[]
  links    JobLink[]

  mandatorySkills   Skill[] @relation("MandatorySkills")
  recommendedSkills Skill[] @relation("RecommendedSkills")

  @@map("jobs")
}

model JobComment {
  id   Int      @id @default(autoincrement())
  text String
  date DateTime @default(now())

  jobId Int
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_comments")
}

model JobContact {
  id       Int     @id @default(autoincrement())
  name     String
  role     String?
  linkedin String?
  phone    String?

  jobId Int
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_contacts")
}

model JobLink {
  id    Int    @id @default(autoincrement())
  title String
  url   String

  jobId Int
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_links")
}
